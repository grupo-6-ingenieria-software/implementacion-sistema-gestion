{
  "name": "sistema-gestion-huascar",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "author": "Grupo 6 - Ingenieria de Software",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:debug": "HUASCAR_DEBUG_LOGIN=1 electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win --publish always",
    "build:mac": "electron-vite build && electron-builder --mac --publish always",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:triggers": "tsx src/db/scripts/apply-triggers.ts"
  },
  "dependencies": {
    "@libsql/client": "0.17.2",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.2",
    "electron-updater": "6.8.9",
    "exceljs": "^4.4.0",
    "jsonwebtoken": "9.0.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^17.0.0",
    "drizzle-kit": "0.31.11",
    "electron": "42.11.10",
    "electron-builder": "26.15.3",
    "electron-log": "5.4.3",
    "electron-vite": "5.0.0",
    "playwright": "1.59.1",
    "tailwindcss": "4.2.2",
    "tsx": "^4.0.0",
    "typescript": "6.0.3",
    "vite": "^7.0.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "5.1.0"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "vite": {
      "esbuild": "0.28.2"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "build": {
    "appId": "cl.huascar.sistemagestion",
    "productName": "Sistema Gestion Huascar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "drizzle",
        "to": "drizzle"
      },
      {
        "from": "src/db/triggers.sql",
        "to": "triggers.sql"
      }
    ],
    "win": {
      "target": "portable"
    },
    "mac": {
      "target": "dmg"
    },
    "publish": {
      "provider": "github",
      "owner": "grupo-6-ingenieria-software",
      "repo": "implementacion-sistema-gestion",
      "releaseType": "release"
    }
  }
}
